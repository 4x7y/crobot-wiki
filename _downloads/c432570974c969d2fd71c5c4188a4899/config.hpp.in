/* config.hpp. Generated by CMake for @PROJECT_NAME@. */
#ifndef CROBOT_CONFIG_HPP
#define CROBOT_CONFIG_HPP

/* Version number */
#define CROBOT_MAJOR_VERSION @CROBOT_MAJOR_VERSION @
#define CROBOT_MINOR_VERSION @CROBOT_MINOR_VERSION @
#define CROBOT_PATCH_VERSION @CROBOT_PATCH_VERSION @

#define CROBOT_VERSION "@CROBOT_VERSION@"
#define CROBOT_DESCRIPTION "@CROBOT_PKG_DESC@"

#define CROBOT_VERSION_AT_LEAST(x, y, z)                                       \
  (CROBOT_MAJOR_VERSION > x                                                    \
   || (CROBOT_MAJOR_VERSION >= x                                               \
       && (CROBOT_MINOR_VERSION > y                                            \
           || (CROBOT_MINOR_VERSION >= y && CROBOT_PATCH_VERSION >= z))))

#define CROBOT_MAJOR_MINOR_VERSION_AT_LEAST(x, y)                              \
  (CROBOT_MAJOR_VERSION > x                                                    \
   || (CROBOT_MAJOR_VERSION >= x                                               \
       && (CROBOT_MINOR_VERSION > y || (CROBOT_MINOR_VERSION >= y))))

#define CROBOT_VERSION_AT_MOST(x, y, z)                                        \
  (CROBOT_MAJOR_VERSION < x                                                    \
   || (CROBOT_MAJOR_VERSION <= x                                               \
       && (CROBOT_MINOR_VERSION < y                                            \
           || (CROBOT_MINOR_VERSION <= y && CROBOT_PATCH_VERSION <= z))))

#define CROBOT_MAJOR_MINOR_VERSION_AT_MOST(x, y)                               \
  (CROBOT_MAJOR_VERSION < x                                                    \
   || (CROBOT_MAJOR_VERSION <= x                                               \
       && (CROBOT_MINOR_VERSION < y || (CROBOT_MINOR_VERSION <= y))))

#define EIGEN_VERSION_AT_MOST(x, y, z)                                         \
  (EIGEN_WORLD_VERSION < x                                                     \
   || (EIGEN_WORLD_VERSION <= x                                                \
       && (EIGEN_MAJOR_VERSION < y                                             \
           || (EIGEN_MAJOR_VERSION <= y && EIGEN_MINOR_VERSION <= z))))

// Detect the compiler
#if defined(__clang__)
#  define CROBOT_COMPILER_CLANG
#elif defined(__GNUC__) || defined(__GNUG__)
#  define CROBOT_COMPILER_GCC
#elif defined(_MSC_VER)
#  define CROBOT_COMPILER_MSVC
#endif

#cmakedefine01 BUILD_TYPE_DEBUG
#cmakedefine01 BUILD_TYPE_RELEASE
#cmakedefine01 BUILD_TYPE_RELWITHDEBINFO
#cmakedefine01 BUILD_TYPE_MINSIZEREL

#cmakedefine01 HAVE_IPOPT

#cmakedefine01 CROBOT_ENABLE_SIMD

#define CROBOT_DATA_LOCAL_PATH "@CROBOT_SOURCE_DIR@/data/"
#define CROBOT_DATA_GLOBAL_PATH                                                \
  "@CMAKE_INSTALL_PREFIX@/@CROBOT_ADDITIONAL_DOCUMENTATION_INSTALL_PATH@/"     \
  "data/"
#define CROBOT_RESOURCE_LOCAL_PATH "@CROBOT_SOURCE_DIR@/resources/"
#define CROBOT_RESOURCE_GLOBAL_PATH                                            \
  "@CMAKE_INSTALL_PREFIX@/@CROBOT_ADDITIONAL_DOCUMENTATION_INSTALL_PATH@/"     \
  "resource/"

// See #451
#cmakedefine01 ASSIMP_AISCENE_CTOR_DTOR_DEFINED
#cmakedefine01 ASSIMP_AIMATERIAL_CTOR_DTOR_DEFINED

// Workaround for the fact that Bullet does not add the definition to
// BULLET_DEFINITIONS or generate a #cmakedefine header.
#cmakedefine BT_USE_DOUBLE_PRECISION

#endif // #ifndef CROBOT_CONFIG_HPP
